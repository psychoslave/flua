#!/bin/sh

set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

TEST_LIB_CFLAGS='-Wall -O2 -I../../ -fPIC -shared -undefined dynamic_lookup'

TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
if [ -z "$TIMEOUT_BIN" ]; then
  echo "timeout command not found (need 'timeout' or 'gtimeout')" >&2
  exit 1
fi

RUN_OUTPUT=""
RUN_RC=0
EXPECTED_INCOMPAT=0
UNEXPECTED_FAILURE=0

run() {
  label="$1"
  timeout_s="$2"
  command="$3"
  printf "\n== %s ==\n" "$label"
  RUN_OUTPUT="$(cd "$ROOT" && "$TIMEOUT_BIN" "${timeout_s}s" sh -c "$command" 2>&1)"
  RUN_RC=$?
  if [ -n "$RUN_OUTPUT" ]; then
    printf "%s\n" "$RUN_OUTPUT"
  fi
  if [ "$RUN_RC" -eq 124 ]; then
    echo "TIMEOUT after ${timeout_s}s"
  fi
  return "$RUN_RC"
}

must_run() {
  run "$1" "$2" "$3" || return 1
  return 0
}

must_run_allow_match() {
  label="$1"
  timeout_s="$2"
  command="$3"
  allowed_pattern="$4"
  run "$label" "$timeout_s" "$command" || {
    if printf "%s" "$RUN_OUTPUT" | grep -Eq "$allowed_pattern"; then
      echo "allowed failure matched: $allowed_pattern"
      return 0
    fi
    return 1
  }
  return 0
}

must_run "Clean" 120 \
  "make clean" || exit 1

must_run "Build" 300 \
  "make" || exit 1

must_run "Build testes/libs" 180 \
  "make -C testes/libs CFLAGS='$TEST_LIB_CFLAGS'" || exit 1

must_run "Run testes/main.lua (native kernel)" 180 \
  "cd testes && env -i PATH='$PATH' HOME='$HOME' TERM='$TERM' ../lua main.lua" || exit 1

must_run_allow_match "Run testes/all.lua portable (native kernel)" 900 \
  "cd testes && env -i PATH='$PATH' HOME='$HOME' TERM='$TERM' ../lua -e \"_port=true; _nomsg=true\" all.lua" \
  "/dev/full|/dev/null|Operation not permitted|cannot open file '/dev/" || exit 1

must_run "Smoke no locale" 20 \
  "./lua -e \"print('no-locale-ok')\"" || exit 1

must_run "Smoke UTF-8 identifiers" 20 \
  "./lua -e \"résumé=7; assert(résumé==7); print('unicode-ident-ok')\"" || exit 1

must_run "Smoke LUA_LOCALE=native" 20 \
  "LUA_LOCALE='native' ./lua -e \"print('native-locale-ok')\"" || exit 1

must_run "Test symbolic locale default mode" 20 \
  "LUA_LOCALE='symbolic·transpraxis' ./lua locale/symbolic·transpraxis/🧪/main.lua 🏭" || exit 1

SYMBOLIC_INLINE_CMD="$(cat <<'EOF'
LUA_LOCALE='symbolic·transpraxis' ./lua -e "x←1;assert(x＝1);assert(2﹤3 and 4﹥3);assert(8∕2＝4);assert(7÷2＝3);assert(5⁒2＝1);assert(1≪3＝8);assert(8≫1＝4);assert(6⊗3＝2);assert(6⊙3＝7);assert(5⊕3＝6);assert(⊝0＝−1);assert('a'⧺'b'＝'ab');t←{a←1};assert(t‐a＝1);assert(('ab')–sub(1,1)＝'a');⏭️ L; 🏷L🏷;print('symbolic-inline-ok')"
EOF
)"
must_run "Test symbolic locale inline operators" 20 "$SYMBOLIC_INLINE_CMD" || exit 1

must_run "Test symbolic lexer-phase gaps" 20 \
  "LUA_LOCALE='symbolic·transpraxis' ./lua locale/symbolic·transpraxis/🧪/lexer-phase.lua" || exit 1

must_run "Test symbolic parser-phase gaps" 20 \
  "LUA_LOCALE='symbolic·transpraxis' ./lua locale/symbolic·transpraxis/🧪/parser-phase.lua" || exit 1

must_run "Test symbolic locale plain mode (-P)" 20 \
  "LUA_LOCALE='symbolic·transpraxis' ./lua -P locale/symbolic·transpraxis/🧪/main.lua 💎" || exit 1

must_run "Build Esperanto locale kernel" 300 \
  "make locale-build LUA_KERNEL_LOCALE=esperanto && test -f locale/esperanto/esperanto_kernel_autogenerated.h" || exit 1

run "Run testes/all.lua portable (Esperanto kernel, native locale table)" 900 \
  "cd testes && env -i PATH='$PATH' HOME='$HOME' TERM='$TERM' LUA_LOCALE='native' ../lua -e \"_port=true; _nomsg=true\" all.lua"
if [ "$RUN_RC" -ne 0 ]; then
  if printf "%s" "$RUN_OUTPUT" | grep -Eq "/dev/full|/dev/null|Operation not permitted|cannot open file '/dev/"; then
    echo "allowed failure matched: /dev/full|/dev/null|Operation not permitted|cannot open file '/dev/"
  elif printf "%s" "$RUN_OUTPUT" | grep -Eq "syntax error near|generic·syntax·error near"; then
    echo "expected incompatibility: Esperanto kernel cannot parse native suite as-is"
    EXPECTED_INCOMPAT=$((EXPECTED_INCOMPAT + 1))
  else
    echo "unexpected failure: Esperanto kernel native-suite probe failed unexpectedly"
    UNEXPECTED_FAILURE=1
  fi
fi

must_run "Test Esperanto locale smoke suite" 20 \
  "./lua locale/esperanto/testaro/ĉeftestaro.lua" || exit 1

run "Probe native tests under -P (Esperanto kernel)" 60 \
  "cd testes && env -i PATH='$PATH' HOME='$HOME' TERM='$TERM' ../lua -P main.lua"
if [ "$RUN_RC" -eq 0 ]; then
  echo "note: Esperanto kernel accepted native main.lua under -P (allowed)"
else
  echo "expected strict-mode incompatibility observed (-P, Esperanto kernel)"
fi

must_run "Build symbolic locale kernel" 300 \
  "make locale-build LUA_KERNEL_LOCALE='symbolic·transpraxis' && test -f locale/symbolic·transpraxis/symbolic·transpraxis_kernel_autogenerated.h" || exit 1

run "Run testes/all.lua portable (symbolic kernel, native locale table)" 900 \
  "cd testes && env -i PATH='$PATH' HOME='$HOME' TERM='$TERM' LUA_LOCALE='native' ../lua -e \"_port=true; _nomsg=true\" all.lua"
if [ "$RUN_RC" -ne 0 ]; then
  if printf "%s" "$RUN_OUTPUT" | grep -Eq "/dev/full|/dev/null|Operation not permitted|cannot open file '/dev/"; then
    echo "allowed failure matched: /dev/full|/dev/null|Operation not permitted|cannot open file '/dev/"
  elif printf "%s" "$RUN_OUTPUT" | grep -Eq "syntax error near|generic·syntax·error near"; then
    echo "expected incompatibility: symbolic kernel cannot parse native suite as-is"
    EXPECTED_INCOMPAT=$((EXPECTED_INCOMPAT + 1))
  else
    echo "unexpected failure: symbolic kernel native-suite probe failed unexpectedly"
    UNEXPECTED_FAILURE=1
  fi
fi

must_run "Run symbolic kernel build default mode" 20 \
  "./lua locale/symbolic·transpraxis/🧪/main.lua 🏭" || exit 1

must_run "Run symbolic kernel build plain mode" 20 \
  "./lua -P locale/symbolic·transpraxis/🧪/main.lua 💎" || exit 1

run "Probe native tests under -P (symbolic kernel)" 60 \
  "cd testes && env -i PATH='$PATH' HOME='$HOME' TERM='$TERM' ../lua -P main.lua"
if [ "$RUN_RC" -eq 0 ]; then
  echo "note: symbolic kernel accepted native main.lua under -P (allowed)"
else
  echo "expected strict-mode incompatibility observed (-P, symbolic kernel)"
fi

PLAIN_REJECT_CMD="$(cat <<'EOF'
LUA_LOCALE='symbolic·transpraxis' ./lua -P -e "📍 f,e←load('a=1'); assert(f＝∅ ∧ e ≠ ∅); print('plain-reject-ok')"
EOF
)"
must_run "Test -P rejects native '='" 20 "$PLAIN_REJECT_CMD" || exit 1

run "Smoke missing locale fallback" 20 \
  "LUA_LOCALE='does-not-exist' ./lua -e \"print('missing-locale-fallback-ok')\"" || exit 1
if ! printf "%s" "$RUN_OUTPUT" | grep -Fq "failed to load locale"; then
  echo "expected missing-locale warning not found" >&2
  exit 1
fi

if [ "$UNEXPECTED_FAILURE" -ne 0 ]; then
  echo "Healthcheck failed (unexpected failures present)" >&2
  exit 1
fi

if [ "$EXPECTED_INCOMPAT" -gt 0 ]; then
  printf "\nHealthcheck OK (with %s expected incompatibility checks)\n" "$EXPECTED_INCOMPAT"
  exit 0
fi

printf "\nHealthcheck OK\n"
