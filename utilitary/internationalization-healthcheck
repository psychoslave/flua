#!/usr/bin/env -S ./lua

local function shq(s)
  return "'" .. tostring(s):gsub("'", [['"'"']]) .. "'"
end

local function rstrip(s)
  return (s:gsub("%s+$", ""))
end

local function dirname(path)
  local d = path:match("^(.*)/[^/]+$")
  return d or "."
end

local function detect_root()
  local script = arg[0] or "utilitary/internationalization-healthcheck"
  local cmd = "cd " .. shq(dirname(script) .. "/..") .. " && pwd"
  local p = assert(io.popen(cmd, "r"))
  local out = p:read("*a")
  p:close()
  out = rstrip(out)
  return (out ~= "" and out) or "."
end

local ROOT = detect_root()

local function detect_timeout_bin()
  local p = assert(io.popen("command -v timeout || command -v gtimeout || true", "r"))
  local out = rstrip(p:read("*a"))
  p:close()
  if out == "" then
    io.stderr:write("timeout command not found (need 'timeout' or 'gtimeout')\n")
    os.exit(1)
  end
  return out
end

local TIMEOUT_BIN = detect_timeout_bin()

local function run(label, command, timeout)
  print("\n== " .. label .. " ==")
  local wrapped = string.format("%s %ss sh -c %s 2>&1",
                                TIMEOUT_BIN, tostring(timeout), shq(command))
  local p = assert(io.popen(wrapped, "r"))
  local output = p:read("*a")
  local ok, how, code = p:close()
  if output ~= "" then
    print(rstrip(output))
  end
  if ok then
    return 0, output
  end
  if how == "exit" and code == 124 then
    print("TIMEOUT after " .. timeout .. "s")
    return 124, output
  end
  return (how == "exit" and code) or 1, output
end

local function in_root(command)
  return "cd " .. shq(ROOT) .. " && " .. command
end

local function must_run(label, command, timeout)
  local rc = run(label, in_root(command), timeout)
  return rc == 0
end

local function main()
  local path = os.getenv("PATH") or ""
  local home = os.getenv("HOME") or ""
  local term = os.getenv("TERM") or ""

  if not must_run(
      "Build",
      "make MYCFLAGS=" ..
      shq('-std=c99 -DLUA_USE_POSIX -DLUA_USE_DLOPEN -DLUA_READLINELIB="\\"/opt/homebrew/opt/readline/lib/libreadline.dylib\\""') ..
      " MYLDFLAGS='' MYLIBS='' CC=cc",
      300) then
    return 1
  end

  if not must_run(
      "Build testes/libs",
      "make -C testes/libs " ..
      "CFLAGS=" .. shq("-Wall -O2 -I../../ -fPIC -shared -undefined dynamic_lookup"),
      180) then
    return 1
  end

  if not must_run(
      "Run testes/main.lua",
      "cd testes && env -i PATH=" .. shq(path) .. " HOME=" .. shq(home) .. " TERM=" .. shq(term) ..
      " ../lua main.lua",
      180) then
    return 1
  end

  if not must_run("Smoke no locale", [[./lua -e "print('no-locale-ok')"]], 20) then
    return 1
  end

  if not must_run("Smoke LUA_LOCALE=native", [[LUA_LOCALE='native' ./lua -e "print('native-locale-ok')"]], 20) then
    return 1
  end

  if not must_run(
      "Test symbolic locale default mode",
      [[LUA_LOCALE='symbolic·transpraxis' ./lua testes/symbolic-locale.lua default]],
      20) then
    return 1
  end

  if not must_run(
      "Test symbolic locale inline operators",
      [[LUA_LOCALE='symbolic·transpraxis' ./lua -e "x←1;assert(x＝1);print('symbolic-inline-ok')"]],
      20) then
    return 1
  end

  if not must_run(
      "Test symbolic locale plain mode (-P)",
      [[LUA_LOCALE='symbolic·transpraxis' ./lua -P testes/symbolic-locale.lua plain]],
      20) then
    return 1
  end

  if not must_run(
      "Test -P rejects native '='",
      [[LUA_LOCALE='symbolic·transpraxis' ./lua -P -e "📍 f,e←load('a=1'); assert(f＝nil and string.find(e, '⚠', 1, true)); print('plain-reject-ok')"]],
      20) then
    return 1
  end

  local rc, out = run(
    "Smoke missing locale fallback",
    in_root([[LUA_LOCALE='does-not-exist' ./lua -e "print('missing-locale-fallback-ok')"]]),
    20
  )
  if rc ~= 0 then
    return 1
  end
  if not out:find("failed to load locale", 1, true) then
    io.stderr:write("expected missing-locale warning not found\n")
    return 1
  end

  print("\nHealthcheck OK")
  return 0
end

os.exit(main())
